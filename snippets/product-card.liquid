<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}">
    {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}
    {% if product.compare_at_price > product.price %}<span class="product-badge">Sale</span>{% endif %}
  </a>
  <div class="product-card__info">
    {% if product.vendor != blank %}<div class="product-card__brand">{{ product.vendor }}</div>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
  </div>
</article>
