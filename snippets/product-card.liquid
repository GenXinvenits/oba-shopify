{% assign card_variant = product.selected_or_first_available_variant %}
<article class="product-card">
  <div class="product-card__media-wrap">
    <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 50vw', class: 'product-card__image product-card__image--primary' }}
        {% if product.images.size > 1 %}
          {{ product.images[1] | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 50vw', class: 'product-card__image product-card__image--secondary' }}
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {% endif %}
      <span class="product-card__badges">
        {% if product.compare_at_price > product.price %}
          <span class="product-badge product-badge--sale">Sale</span>
        {% endif %}
        {% if product.tags contains 'New' or product.tags contains 'new' %}
          <span class="product-badge product-badge--new">New</span>
        {% endif %}
      </span>
      <span class="product-card__quick">View product <span aria-hidden="true">↗</span></span>
    </a>

    {% if card_variant != blank and card_variant.available %}
      <div class="product-card__actions" aria-label="Product actions">
        <form class="product-card__action-form" method="post" action="{{ routes.cart_add_url }}" data-product-card-form>
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="product-card__action-button product-card__action-button--cart" aria-label="Add {{ product.title | escape }} to cart" title="Add to cart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4h2l1.65 10.7a2.15 2.15 0 0 0 2.1 1.8h8.55a2.1 2.1 0 0 0 2-1.65L21 8H6.25"></path><circle cx="9.5" cy="20" r="1.15"></circle><circle cx="18" cy="20" r="1.15"></circle></svg>
          </button>
        </form>
        <a class="product-card__action-button product-card__action-button--buy" href="{{ routes.cart_url }}/{{ card_variant.id }}:1?checkout=1" aria-label="Buy {{ product.title | escape }} now" title="Buy now">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 2.5 5 13h6l-.5 8.5L19 11h-6l.5-8.5Z"></path></svg>
        </a>
      </div>
    {% endif %}
  </div>

  <div class="product-card__info">
    <div class="product-card__meta">
      {% if product.vendor != blank %}<span class="product-card__brand">{{ product.vendor }}</span>{% endif %}
      {% if product.available %}<span class="product-card__availability">In stock</span>{% endif %}
    </div>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__footer">
      <div class="price">
        {{ product.price | money }}
        {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
      </div>
      {% if product.price_varies %}<span class="product-card__from">From</span>{% endif %}
    </div>
  </div>
</article>
