<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><div class="eyebrow">OBA Pro Shop</div><h2>{{ section.settings.heading }}</h2></div>
      {% if section.settings.collection != blank %}<a class="button" href="{{ section.settings.collection.url }}">View collection</a>{% endif %}
    </div>
    {% assign selected_collection = section.settings.collection %}
    {% if selected_collection != blank %}
      <div class="product-grid">
        {% for product in selected_collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}
      </div>
    {% else %}
      <p>Select a collection in the theme editor to populate this section.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"NEW & NOTABLE"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":4,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured products"}]}
{% endschema %}
