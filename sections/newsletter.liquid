<section class="newsletter">
  <div class="container newsletter-grid">
    <div><div class="eyebrow">Stay connected</div><h2>{{ section.settings.heading }}</h2></div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
      <button type="submit">{{ section.settings.button }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"GET IN THE GAME."},{"type":"text","id":"button","label":"Button","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
