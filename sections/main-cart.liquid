<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">Your gear</div><h1>Cart</h1></div></div>{% if cart.item_count == 0 %}<p>Your cart is empty.</p><a class="button" href="{{ routes.collections_url }}">Shop the Pro Shop</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item"><div class="cart-item__image">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: loading:'lazy' }}{% endif %}</div><div><div class="product-card__brand">{{ item.product.vendor }}</div><h3>{{ item.product.title }}</h3><p>{{ item.final_line_price | money }}</p><label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div></div>{% endfor %}</div><div class="cart-summary"><strong>Subtotal {{ cart.total_price | money }}</strong><button class="button" type="submit" name="update">Update cart</button><button class="button" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</div></section><style>.cart-items{border-top:1px solid var(--oba-line)}.cart-item{display:grid;grid-template-columns:180px 1fr;gap:25px;padding:20px 0;border-bottom:1px solid var(--oba-line)}.cart-item__image{background:#fff;aspect-ratio:1}.cart-item__image img{width:100%;height:100%;object-fit:contain}.cart-item input{width:70px;padding:10px;border:1px solid var(--oba-line)}.cart-summary{display:flex;justify-content:flex-end;align-items:center;gap:12px;padding-top:30px}@media(max-width:600px){.cart-item{grid-template-columns:110px 1fr}.cart-summary{display:grid;justify-content:stretch}.cart-summary .button{width:100%}}</style>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
