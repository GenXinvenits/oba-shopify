<section class="section product-page product-page--editorial">
  <div class="container">
    <div class="product-layout product-layout--yonex">
      <div class="product-gallery product-gallery--editorial">
        <div class="product-main-images" data-product-gallery>
          <div class="product-image-grid">
            {% for image in product.images %}
              <figure id="ProductImage-{{ image.id }}" class="product-image{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}">
                <button type="button" class="product-image__zoom" data-image-zoom aria-label="Open enlarged image: {{ image.alt | default: product.title | escape }}">
                  {{ image | image_url: width: 1800 | image_tag: loading: forloop.first | default: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(min-width: 1000px) 55vw, 100vw', alt: image.alt | default: product.title | escape }}
                  <span class="product-image__zoom-hint" aria-hidden="true">⌕</span>
                </button>
              </figure>
            {% endfor %}
          </div>
          {% if product.images.size > 1 %}
            <button type="button" class="product-gallery-arrow product-gallery-arrow--prev" data-gallery-prev aria-label="Previous product image">‹</button>
            <button type="button" class="product-gallery-arrow product-gallery-arrow--next" data-gallery-next aria-label="Next product image">›</button>
            <div class="product-gallery-count" aria-live="polite"><span data-gallery-current>1</span> / {{ product.images.size }}</div>
          {% endif %}
        </div>

        {% if product.images.size > 0 %}
          <div class="product-thumbs" aria-label="Product images">
            {% for image in product.images %}
              <a href="#ProductImage-{{ image.id }}" class="product-thumb{% if forloop.first %} is-active{% endif %}">
                {{ image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120,180,220', sizes: '72px', alt: image.alt | default: product.title | escape }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-details product-details--editorial">
        {% if product.vendor != blank %}
          <a class="product-brand" href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor }}</a>
        {% endif %}
        <h1>{{ product.title }}</h1>

        {% if product.description != blank %}
          <div class="product-short-description">{{ product.description | strip_html | truncate: 180 }}</div>
        {% endif %}

        <div class="product-price-row">
          <span class="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="product-was"><s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></span>
            <span class="product-sale-badge">Sale</span>
          {% endif %}
        </div>

        <div class="product-shipping-callout">Shipping calculated at checkout.</div>

        {% form 'product', product, class: 'product-buy-form', data-product-form: true %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-product-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="product-options">
              {% for option in product.options_with_values %}
                <div class="product-option">
                  <label for="ProductOption-{{ section.id }}-{{ option.position }}">{{ option.name }}</label>
                  <select id="ProductOption-{{ section.id }}-{{ option.position }}" name="options[{{ option.name | escape }}]" data-product-option="{{ option.position }}">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="product-purchase-box">
            <div class="product-purchase-row">
              <label for="ProductQuantity-{{ section.id }}">Quantity</label>
              <input id="ProductQuantity-{{ section.id }}" class="product-quantity" type="number" name="quantity" min="1" value="1" aria-label="Quantity">
            </div>
            <button class="button product-add" type="submit" data-product-add {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
            {% if product.available %}
              <div class="product-buy-now">{{ form | payment_button }}</div>
            {% endif %}
          </div>
        {% endform %}

        <div class="product-assurance">
          <div><strong>AUTHENTIC PRODUCTS</strong><span>Genuine equipment from trusted brands.</span></div>
          <div><strong>PLAYER FOCUSED</strong><span>Selected for training, play and competition.</span></div>
          <div><strong>READY TO SHIP</strong><span>Fast fulfilment on available products.</span></div>
        </div>

        <div class="product-accordions">
          <details open>
            <summary>Description <span>+</span></summary>
            <div class="product-accordion-content">
              {% if product.description != blank %}{{ product.description }}{% else %}<p>Authentic badminton equipment selected by OBA for players who train, play and compete.</p>{% endif %}
            </div>
          </details>
          <details>
            <summary>Shipping & returns <span>+</span></summary>
            <div class="product-accordion-content"><p>Shipping is calculated at checkout. Returns and exchanges are subject to the store's current policy.</p></div>
          </details>
        </div>
      </div>
    </div>

    <div class="product-editorial" id="product-content">
      <div class="product-editorial__intro">
        <span class="eyebrow">Built for the game</span>
        <h2>{{ product.title }}</h2>
        <p>Performance equipment deserves a product experience that puts the details first.</p>
      </div>
      <div class="product-information__content">
        {% if product.description != blank %}{{ product.description }}{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.product-page--editorial{padding-top:32px;padding-bottom:80px}
.product-layout--yonex{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(360px,.82fr);gap:clamp(36px,5vw,84px);align-items:start}
.product-gallery--editorial{min-width:0}
.product-main-images{position:relative;min-width:0}
.product-image-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.product-image{position:relative;display:block;margin:0;min-width:0;aspect-ratio:1/1;background:#f8f8f8;overflow:hidden}
.product-image:first-child{grid-column:1/-1;aspect-ratio:4/3}
.product-image:not(.is-active){display:block}
.product-image__zoom{position:relative;width:100%;height:100%;padding:0;border:0;display:block;overflow:hidden;cursor:zoom-in;background:#f8f8f8}
.product-image__zoom img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.product-image__zoom:hover img{transform:scale(1.035)}
.product-image__zoom-hint{position:absolute;right:16px;bottom:16px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.94);color:#101010;font-size:23px;line-height:1;font-weight:800;box-shadow:0 5px 18px rgba(0,0,0,.14);pointer-events:none}
.product-gallery-arrow{display:none}
.product-gallery-count{position:absolute;right:14px;bottom:14px;padding:7px 11px;border-radius:999px;background:#101010;color:#fff;font-size:10px;font-weight:800;letter-spacing:.08em;line-height:1}
.product-thumbs{display:flex;gap:8px;margin-top:10px;overflow-x:auto;padding-bottom:3px;scrollbar-width:thin}
.product-thumb{display:block;flex:0 0 72px;aspect-ratio:1;background:#f8f8f8;border:1px solid transparent;overflow:hidden}
.product-thumb:hover,.product-thumb.is-active{border-color:#101010}
.product-thumb img{display:block;width:100%;height:100%;object-fit:contain}
.product-details--editorial{position:sticky;top:96px;height:max-content;padding-top:6px}
.product-brand{display:inline-block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.14em;text-decoration:none;color:#101010;margin-bottom:10px}
.product-details h1{font-size:clamp(38px,4vw,64px);line-height:.96;letter-spacing:-.055em;margin:0 0 18px}
.product-short-description{font-size:15px;line-height:1.55;color:var(--oba-muted);max-width:520px;margin-bottom:24px}
.product-price-row{display:flex;align-items:center;gap:12px;padding:18px 0;border-top:1px solid var(--oba-line);border-bottom:1px solid var(--oba-line)}
.product-price{font-size:28px;font-weight:900}.product-was{font-size:14px;color:var(--oba-muted)}
.product-sale-badge{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;padding:6px 9px;border-radius:999px;background:var(--oba-accent);color:#101010}
.product-shipping-callout{padding:14px 0 22px;font-size:12px;color:var(--oba-muted)}
.product-options{display:grid;gap:14px;margin-bottom:18px}
.product-option{display:grid;gap:7px}.product-option label{font-size:12px;font-weight:900}
.product-option select,.product-quantity{width:100%;height:48px;background:#fff;border:1px solid #b9b9b2;border-radius:4px;padding:0 13px;color:#101010;font-size:14px}
.product-purchase-box{display:grid;grid-template-columns:1fr;gap:10px;padding:0;margin:0}
.product-purchase-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.product-purchase-row label{font-size:12px;font-weight:900}.product-quantity{width:90px}
.product-purchase-box>.product-add{width:100%;min-height:54px;border-radius:0;background:#101010;color:#fff;border-color:#101010;-webkit-text-fill-color:#fff;font-weight:900;box-shadow:none!important}
.product-buy-now{width:100%}.product-buy-now .shopify-payment-button{width:100%;margin:0}.product-buy-now .shopify-payment-button__button{width:100%;min-height:54px!important;border-radius:0!important;margin:0!important;box-shadow:none!important}
.product-purchase-box>.product-add:hover,.product-buy-now .shopify-payment-button__button:hover{background:var(--oba-accent)!important;color:#101010!important;border-color:var(--oba-accent)!important;-webkit-text-fill-color:#101010}
.product-add:disabled{opacity:.45;cursor:not-allowed}
.product-assurance{display:grid;gap:0;border-top:1px solid var(--oba-line);margin-top:28px}
.product-assurance>div{display:grid;grid-template-columns:145px 1fr;gap:16px;padding:14px 0;border-bottom:1px solid var(--oba-line)}
.product-assurance strong{font-size:10px;letter-spacing:.1em}.product-assurance span{font-size:12px;color:var(--oba-muted)}
.product-accordions{margin-top:8px;border-bottom:1px solid var(--oba-line)}
.product-accordions details{border-top:1px solid var(--oba-line)}
.product-accordions summary{list-style:none;cursor:pointer;padding:17px 0;font-size:13px;font-weight:900;display:flex;justify-content:space-between;align-items:center}
.product-accordions summary::-webkit-details-marker{display:none}.product-accordions summary span{font-size:20px;font-weight:400;transition:transform .2s}.product-accordions details[open] summary span{transform:rotate(45deg)}
.product-accordion-content{padding:0 0 20px;color:var(--oba-muted);font-size:13px;line-height:1.7}.product-accordion-content p{margin:0}
.product-editorial{margin-top:clamp(70px,10vw,140px);padding-top:clamp(50px,7vw,90px);border-top:1px solid var(--oba-line)}
.product-editorial__intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.6fr);gap:30px;align-items:end;margin-bottom:55px}
.product-editorial__intro .eyebrow{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.product-editorial__intro h2{font-size:clamp(42px,7vw,96px);line-height:.88;letter-spacing:-.065em;margin:12px 0 0}.product-editorial__intro p{font-size:15px;line-height:1.6;color:var(--oba-muted);margin:0}
.product-information__content{max-width:1000px;margin:0 auto;font-size:15px;line-height:1.8}
.product-information__content>*:first-child{margin-top:0}
.product-information__content h1,.product-information__content h2,.product-information__content h3,.product-information__content h4{color:var(--oba-ink);letter-spacing:-.035em}
.product-information__content h1,.product-information__content h2{font-size:clamp(30px,5vw,58px);line-height:.95;margin:55px 0 18px}.product-information__content h3{font-size:clamp(23px,3vw,36px);line-height:1;margin:42px 0 12px}.product-information__content h4{font-size:12px;text-transform:uppercase;letter-spacing:.1em;margin:30px 0 8px}
.product-information__content p{margin:0 0 20px}.product-information__content img{display:block;width:100%;max-width:900px;height:auto;margin:35px auto;border-radius:0;background:#f8f8f8}.product-information__content table{width:100%;border-collapse:collapse;margin:25px 0 50px}.product-information__content td,.product-information__content th{padding:14px 16px;border-bottom:1px solid var(--oba-line);text-align:left}.product-information__content td:first-child,.product-information__content th:first-child{font-weight:900;width:30%}
@media(max-width:1000px){.product-layout--yonex{grid-template-columns:minmax(0,1fr) minmax(320px,.8fr);gap:30px}.product-details h1{font-size:clamp(36px,5vw,52px)}}
@media(max-width:800px){.product-layout--yonex{grid-template-columns:1fr}.product-details--editorial{position:static;padding-top:10px}.product-image-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-image:first-child{aspect-ratio:1/1}.product-gallery-arrow{display:flex;position:absolute;z-index:4;top:50%;transform:translateY(-50%);width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,255,255,.94);color:#101010;font-size:28px;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.15)}.product-gallery-arrow--prev{left:12px}.product-gallery-arrow--next{right:12px}.product-image-grid .product-image:not(:first-child){display:none}.product-image-grid .product-image.is-active{display:block}.product-editorial__intro{grid-template-columns:1fr}.product-editorial__intro p{max-width:520px}}
@media(max-width:600px){.product-page--editorial{padding-top:18px;padding-bottom:50px}.product-image-grid{gap:6px}.product-image__zoom-hint{right:10px;bottom:10px;width:36px;height:36px}.product-thumbs{gap:6px}.product-thumb{flex-basis:62px}.product-details h1{font-size:42px}.product-assurance>div{grid-template-columns:1fr;gap:5px}.product-editorial{margin-top:70px;padding-top:42px}.product-editorial__intro h2{font-size:56px}}
</style>

<div class="product-image-modal" data-image-modal hidden aria-hidden="true">
  <div class="product-image-modal__backdrop" data-image-modal-close></div>
  <div class="product-image-modal__panel" role="dialog" aria-modal="true" aria-label="Enlarged product image">
    <button type="button" class="product-image-modal__close" data-image-modal-close aria-label="Close enlarged image">×</button>
    <div class="product-image-modal__viewport" data-image-modal-viewport><img class="product-image-modal__image" data-image-modal-image src="" alt=""></div>
    <div class="product-image-modal__zoom-controls" aria-label="Image magnification"><button type="button" class="product-image-modal__zoom-button" data-zoom-step="-1" aria-label="Zoom out">−</button><span class="product-image-modal__zoom-level" data-zoom-level-label>100%</span><button type="button" class="product-image-modal__zoom-button" data-zoom-step="1" aria-label="Zoom in">+</button></div>
  </div>
</div>

<style>
.product-image-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:28px}.product-image-modal[hidden]{display:none}.product-image-modal__backdrop{position:absolute;inset:0;background:rgba(16,16,16,.72);backdrop-filter:blur(5px);cursor:zoom-out}.product-image-modal__panel{position:relative;z-index:1;width:min(92vw,1100px);height:min(88vh,850px);background:#f8f8f8;border-radius:8px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.35)}.product-image-modal__viewport{position:absolute;inset:0;overflow:auto;cursor:grab}.product-image-modal__image{display:block;width:100%;height:100%;min-width:100%;min-height:100%;max-width:none;object-fit:contain;padding:28px;transform-origin:center;transition:transform .2s ease}.product-image-modal__zoom-controls{position:absolute;left:14px;bottom:14px;z-index:3;display:flex;gap:6px;padding:6px;border-radius:999px;background:rgba(255,255,255,.94);box-shadow:0 3px 14px rgba(0,0,0,.14)}.product-image-modal__zoom-button{width:40px;height:36px;border:1px solid #101010;border-radius:999px;background:#101010;color:#fff;font-size:17px;font-weight:900;cursor:pointer}.product-image-modal__zoom-level{min-width:52px;height:36px;display:grid;place-items:center;color:#101010;background:#fff;border-radius:999px;font-size:12px;font-weight:900}.product-image-modal__close{position:absolute;right:14px;top:14px;z-index:2;width:42px;height:42px;border:1px solid rgba(16,16,16,.14);border-radius:50%;background:rgba(255,255,255,.94);color:#101010;font-size:30px;cursor:pointer}.product-image-modal__close:hover{background:var(--oba-accent)}
@media(max-width:600px){.product-image-modal{padding:12px}.product-image-modal__panel{width:96vw;height:82vh}.product-image-modal__image{padding:16px}}
</style>

<script type="application/json" data-product-variants>{{ product.variants | json }}</script>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}

<script>
(function(){
  function initProductVariants(){
    var form=document.querySelector('[data-product-form]');
    if(!form || form.dataset.variantsReady) return;
    form.dataset.variantsReady='true';
    var variantInput=form.querySelector('[data-product-variant-id]'),addButton=form.querySelector('[data-product-add]'),optionSelects=[...form.querySelectorAll('[data-product-option]')],variantsEl=document.querySelector('[data-product-variants]');
    if(!variantInput || !addButton || !variantsEl) return;
    var variants=[];try{variants=JSON.parse(variantsEl.textContent||'[]')}catch(e){return}
    function sync(){
      var selected=optionSelects.map(function(s){return s.value}),variant=variants.find(function(v){return !optionSelects.length||v.options.every(function(value,i){return value===selected[i]})});
      if(!variant)return;variantInput.value=variant.id;addButton.disabled=!variant.available;addButton.textContent=variant.available?'Add to cart':'Sold out';
    }
    optionSelects.forEach(function(s){s.addEventListener('change',sync)});sync();
  }
  function initProductModal(){
    var modal=document.querySelector('[data-image-modal]');if(!modal||modal.dataset.ready)return;modal.dataset.ready='true';
    var image=modal.querySelector('[data-image-modal-image]'),viewport=modal.querySelector('[data-image-modal-viewport]'),zoomButtons=modal.querySelectorAll('[data-zoom-step]'),label=modal.querySelector('[data-zoom-level-label]'),index=0,levels=[1,2,3];
    function zoom(i){index=Math.max(0,Math.min(levels.length-1,i));image.style.transform='scale('+levels[index]+')';label.textContent=(levels[index]*100)+'%';zoomButtons.forEach(function(b){var s=Number(b.dataset.zoomStep);b.disabled=(s<0&&index===0)||(s>0&&index===levels.length-1)})}
    function close(){modal.hidden=true;modal.setAttribute('aria-hidden','true');document.body.style.overflow=''}
    document.querySelectorAll('[data-image-zoom]').forEach(function(t){t.addEventListener('click',function(){var img=t.querySelector('img');if(!img)return;image.src=img.currentSrc||img.src;image.alt=img.alt||'';zoom(0);viewport.scrollLeft=0;viewport.scrollTop=0;modal.hidden=false;modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'})});
    modal.querySelectorAll('[data-image-modal-close]').forEach(function(b){b.addEventListener('click',close)});zoomButtons.forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();zoom(index+Number(b.dataset.zoomStep))})});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)close()});
  }
  function initProductGallery(root){if(!root||root.dataset.galleryReady)return;root.dataset.galleryReady='true';var slides=[...root.querySelectorAll('[data-gallery-slide]')],thumbs=[...document.querySelectorAll('.product-thumb')],current=root.querySelector('[data-gallery-current]'),prev=root.querySelector('[data-gallery-prev]'),next=root.querySelector('[data-gallery-next]'),index=0;if(slides.length<2){if(prev)prev.hidden=true;if(next)next.hidden=true;return}function show(i){index=(i+slides.length)%slides.length;slides.forEach(function(s,n){s.classList.toggle('is-active',n===index)});thumbs.forEach(function(t,n){t.classList.toggle('is-active',n===index)});if(current)current.textContent=index+1}prev&&prev.addEventListener('click',function(){show(index-1)});next&&next.addEventListener('click',function(){show(index+1)});thumbs.forEach(function(t,n){t.addEventListener('click',function(e){e.preventDefault();show(n)})});show(0)}
  function initProductMagnifier(){
    document.querySelectorAll('.product-image__zoom').forEach(function(target){
      if(target.dataset.magnifierReady)return;
      target.dataset.magnifierReady='true';
      var img=target.querySelector('img');
      if(!img)return;
      target.addEventListener('mousemove',function(e){
        if(window.matchMedia('(max-width: 767px)').matches)return;
        var rect=target.getBoundingClientRect();
        var x=((e.clientX-rect.left)/rect.width)*100;
        var y=((e.clientY-rect.top)/rect.height)*100;
        img.style.transformOrigin=x+'% '+y+'%';
      });
      target.addEventListener('mouseleave',function(){img.style.transformOrigin='center center';});
    });
  }
  initProductVariants();initProductModal();document.querySelectorAll('[data-product-gallery]').forEach(initProductGallery);initProductMagnifier();
})();
</script>
