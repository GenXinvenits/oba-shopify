<section class="section product-page product-page--split">
  <div class="container">
    <nav class="product-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>/</span>
      {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-layout product-layout--split">
      <div class="product-gallery product-gallery--split">
        <div class="product-thumbs" aria-label="Product images">
          {% for image in product.images %}
            <a href="#ProductImage-{{ image.id }}" class="product-thumb">
              {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: image.alt | default: product.title | escape }}
            </a>
          {% endfor %}
        </div>
        <div class="product-main-images">
          {% for image in product.images %}
            <figure id="ProductImage-{{ image.id }}" class="product-image">
              {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: image.alt | default: product.title | escape }}
            </figure>
          {% endfor %}
        </div>
      </div>

      <div class="product-details">
        {% if product.vendor != blank %}<a class="product-brand" href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor }}</a>{% endif %}
        <h1>{{ product.title }}</h1>
        <div class="product-rating" aria-label="Product information">
          <span class="product-rating__stars">★★★★★</span>
          <a href="#product-details">See product details</a>
        </div>
        <div class="product-price-row">
          <span class="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="product-was">List price <s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></span>
          {% endif %}
        </div>
        <div class="product-shipping-callout">
          <strong>FREE US shipping</strong> on orders over $125.
        </div>
        {% if product.description != blank %}
          <div class="product-description" id="product-details">{{ product.description }}</div>
        {% endif %}

        {% form 'product', product, class: 'product-buy-form' %}
          {% unless product.has_only_default_variant %}
            <div class="product-option">
              <label for="ProductSelect-{{ section.id }}">Select option</label>
              <select id="ProductSelect-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}

          <div class="product-purchase-box">
            <div class="product-stock">{% if product.available %}In stock{% else %}Currently unavailable{% endif %}</div>
            <div class="product-purchase-row">
              <label for="ProductQuantity-{{ section.id }}">Qty</label>
              <select id="ProductQuantity-{{ section.id }}" name="quantity" aria-label="Quantity">
                {% for quantity in (1..10) %}<option value="{{ quantity }}">{{ quantity }}</option>{% endfor %}
              </select>
            </div>
            <button class="button product-add" type="submit" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
            <button class="button button--buy-now" type="submit" name="add" value="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>
              Buy now
            </button>
            <div class="product-trust">Secure checkout · Authentic OBA Pro Shop gear · Easy cart updates</div>
          </div>
        {% endform %}
      </div>
    </div>

    <div class="product-information">
      <div><div class="eyebrow">Product information</div><h2>Built for your game.</h2></div>
      <div class="product-information__content">
        {% if product.description != blank %}{{ product.description }}{% else %}<p>Authentic badminton equipment selected by OBA for players who train, play and compete.</p>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.product-page{padding-top:28px}.product-breadcrumbs{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:var(--oba-muted);font-size:11px;margin-bottom:28px}.product-breadcrumbs a:hover{text-decoration:underline}
.product-layout--amazon{grid-template-columns:minmax(0,1.25fr) minmax(360px,.75fr);gap:52px}.product-gallery{display:grid;grid-template-columns:76px minmax(0,1fr);gap:16px;align-items:start}.product-thumbs{display:flex;flex-direction:column;gap:9px;position:sticky;top:105px}.product-thumb{display:block;background:#fff;border:1px solid var(--oba-line);aspect-ratio:1;overflow:hidden}.product-thumb:hover{border-color:var(--oba-ink)}.product-thumb img{width:100%;height:100%;object-fit:contain}.product-main-images{display:grid;gap:14px}.product-image{background:#fff;margin:0;aspect-ratio:1;scroll-margin-top:100px}.product-image img{width:100%;height:100%;object-fit:contain}
.product-details{position:sticky;top:105px;height:max-content}.product-brand{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;text-decoration:underline;text-underline-offset:3px}.product-details h1{font-size:clamp(34px,4vw,56px);line-height:.95;letter-spacing:-.05em;margin:10px 0 14px}.product-rating{display:flex;gap:12px;align-items:center;font-size:11px;margin-bottom:20px}.product-rating__stars{letter-spacing:2px}.product-rating a{text-decoration:underline}.product-price-row{display:flex;align-items:baseline;gap:14px;padding:17px 0;border-top:1px solid var(--oba-line);border-bottom:1px solid var(--oba-line)}.product-price{font-size:27px;font-weight:800}.product-was{font-size:11px;color:var(--oba-muted)}.product-shipping-callout{padding:14px 0;font-size:12px}.product-description{color:var(--oba-muted);line-height:1.7;font-size:14px;margin:10px 0 24px}.product-option label,.product-purchase-row label{display:block;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}.product-details select{width:100%;height:48px;background:#fff;border:1px solid var(--oba-line);padding:0 12px}.product-purchase-box{margin-top:18px;border:1px solid var(--oba-line);padding:20px;background:#fff}.product-stock{font-weight:800;font-size:15px;margin-bottom:15px}.product-purchase-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}.product-purchase-row label{margin:0}.product-purchase-row select{width:auto;min-width:70px}.product-add,.button--buy-now{width:100%;margin-top:8px;cursor:pointer}.button--buy-now{background:var(--oba-accent);color:var(--oba-ink);border-color:var(--oba-accent)}.product-trust{font-size:10px;color:var(--oba-muted);line-height:1.5;text-align:center;margin-top:14px}.product-information{display:grid;grid-template-columns:1fr 1.5fr;gap:60px;margin-top:90px;padding:55px 0;border-top:1px solid var(--oba-line)}.product-information h2{font-size:clamp(36px,5vw,64px);line-height:.9;letter-spacing:-.05em;margin:10px 0}.product-information__content{font-size:15px;line-height:1.8}.product-information__content p{margin-top:0}
@media(max-width:900px){.product-layout--amazon{grid-template-columns:1fr}.product-details{position:static}.product-information{grid-template-columns:1fr;gap:20px}.product-thumbs{position:static}.product-gallery{grid-template-columns:64px minmax(0,1fr)}}@media(max-width:600px){.product-page{padding-top:18px}.product-gallery{display:flex;flex-direction:column-reverse}.product-thumbs{display:grid;grid-template-columns:repeat(5,1fr);width:100%}.product-main-images{width:100%}.product-details h1{font-size:38px}.product-purchase-box{padding:16px}.product-information{margin-top:55px}}
</style>

{% schema %}{"name":"Main product","settings":[]}{% endschema %}
