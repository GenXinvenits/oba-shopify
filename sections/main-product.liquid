<script>
(function(){
  function initProductZoom(){
    document.querySelectorAll('.product-image__zoom').forEach(function(zoom){
      if(zoom.dataset.zoomReady) return;
      zoom.dataset.zoomReady='true';
      var img=zoom.querySelector('img');
      if(!img) return;
      zoom.addEventListener('mousemove',function(e){
        var rect=zoom.getBoundingClientRect();
        var x=((e.clientX-rect.left)/rect.width)*100;
        var y=((e.clientY-rect.top)/rect.height)*100;
        img.style.transformOrigin=x+'% '+y+'%';
      });
      zoom.addEventListener('mouseleave',function(){
        img.style.transformOrigin='center center';
      });
    });
  }
  initProductZoom();
  function organizeProductDescription(){
    var content=document.querySelector('[data-product-description]');
    var lede=document.querySelector('[data-product-lede]');
    if(!content || !lede || lede.dataset.ready) return;
    var children=[...content.children];
    var specsIndex=children.findIndex(function(node){ return node.textContent.trim().toUpperCase()==='SPECS'; });
    if(specsIndex<0) return;
    children.slice(0,specsIndex).forEach(function(node){ lede.appendChild(node); });
    lede.dataset.ready='true';
  }
  organizeProductDescription();
  function organizeProductDescription(){
    var content=document.querySelector('[data-product-description]');
    var lede=document.querySelector('[data-product-lede]');
    if(!content || !lede || lede.dataset.ready) return;
    var children=[...content.children];
    var specsIndex=children.findIndex(function(node){ return node.textContent.trim().toUpperCase()==='SPECS'; });
    if(specsIndex<0) return;
    children.slice(0,specsIndex).forEach(function(node){ lede.appendChild(node); });
    lede.dataset.ready='true';
  }
  organizeProductDescription();

  function initProductImageModal(){
    var modal=document.querySelector('[data-image-modal]');
    if(!modal || modal.dataset.ready) return;
    modal.dataset.ready='true';
    var modalImage=modal.querySelector('[data-image-modal-image]');
    var viewport=modal.querySelector('[data-image-modal-viewport]');
    var closeButtons=modal.querySelectorAll('[data-image-modal-close]');
    var lastTrigger=null;
    var zoomButtons=modal.querySelectorAll('[data-zoom-step]');
    var zoomLabel=modal.querySelector('[data-zoom-level-label]');
    var zoomLevels=[1,2,3];
    var zoomIndex=0;
    var zoomLevel=1;
    function applyZoom(level){
      zoomLevel=level;
      modalImage.style.transform='scale('+level+')';
      zoomIndex=Math.max(0,zoomLevels.indexOf(level));
      if(zoomLabel) zoomLabel.textContent=Math.round(level*100)+'%';
      zoomButtons.forEach(function(button){
        var step=Number(button.dataset.zoomStep);
        button.disabled=(step<0 && zoomIndex===0)||(step>0 && zoomIndex===zoomLevels.length-1);
      });
    }
    function close(){
      modal.hidden=true;
      modal.setAttribute('aria-hidden','true');
      document.body.style.overflow='';
      if(lastTrigger) lastTrigger.focus();
    }
    document.querySelectorAll('[data-image-zoom]').forEach(function(trigger){
      trigger.addEventListener('click',function(){
        var img=trigger.querySelector('img');
        if(!img) return;
        lastTrigger=trigger;
        modalImage.src=img.currentSrc || img.src;
        modalImage.alt=img.alt || '';
        modalImage.style.transform='scale(1)';
        if(viewport) viewport.scrollLeft=0, viewport.scrollTop=0;
        modal.hidden=false;
        modal.setAttribute('aria-hidden','false');
        document.body.style.overflow='hidden';
      });
    });
    closeButtons.forEach(function(button){button.addEventListener('click',close);});
    zoomButtons.forEach(function(button){
      button.addEventListener('click',function(e){
        e.stopPropagation();
        var nextIndex=Math.max(0,Math.min(zoomLevels.length-1,zoomIndex+Number(button.dataset.zoomStep)));
        applyZoom(zoomLevels[nextIndex]);
      });
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape' && !modal.hidden) close();
    });
  }
  initProductImageModal();
  function initProductGallery(root){
    if(!root || root.dataset.galleryReady) return;
    root.dataset.galleryReady='true';
    var slides=[...root.querySelectorAll('[data-gallery-slide]')];
    var thumbs=[...document.querySelectorAll('.product-thumb')];
    var current=root.querySelector('[data-gallery-current]');
    var prev=root.querySelector('[data-gallery-prev]');
    var next=root.querySelector('[data-gallery-next]');
    var index=0;
    if(slides.length<2){
      if(prev) prev.hidden=true;
      if(next) next.hidden=true;
      return;
    }
    function show(i){
      index=(i+slides.length)%slides.length;
      slides.forEach(function(slide,n){slide.classList.toggle('is-active',n===index);});
      thumbs.forEach(function(thumb,n){thumb.classList.toggle('is-active',n===index);});
      if(current) current.textContent=index+1;
    }
    prev && prev.addEventListener('click',function(){show(index-1);});
    next && next.addEventListener('click',function(){show(index+1);});
    thumbs.forEach(function(thumb,n){
      thumb.addEventListener('click',function(e){e.preventDefault();show(n);});
    });
    show(0);
  }
  document.querySelectorAll('[data-product-gallery]').forEach(initProductGallery);
})();
</script>
