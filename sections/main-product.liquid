<section class="section product-page">
  <div class="container">
    <div class="product-layout product-layout--amazon">
      <div class="product-gallery">
        <div class="product-thumbs" aria-label="Product images">
          {% for image in product.images %}
            <a href="#ProductImage-{{ image.id }}" class="product-thumb">
              {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: image.alt | default: product.title | escape }}
            </a>
          {% endfor %}
        </div>
        <div class="product-main-images" data-product-gallery>
          <button type="button" class="product-gallery-arrow product-gallery-arrow--prev" data-gallery-prev aria-label="Previous product image">‹</button>
          <div class="product-image-track">
            {% for image in product.images %}
              <figure id="ProductImage-{{ image.id }}" class="product-image{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}">
                <button type="button" class="product-image__zoom" data-image-zoom aria-label="Open enlarged image: {{ image.alt | default: product.title | escape }}">
                  {{ image | image_url: width: 1600 | image_tag: loading: forloop.first | default: 'lazy', alt: image.alt | default: product.title | escape }}
                  <span class="product-image__zoom-hint" aria-hidden="true">⌕</span>
                </button>
              </figure>
            {% endfor %}
          </div>
          <button type="button" class="product-gallery-arrow product-gallery-arrow--next" data-gallery-next aria-label="Next product image">›</button>
          <div class="product-gallery-count" aria-live="polite"><span data-gallery-current>1</span> / {{ product.images.size }}</div>
        </div>
      </div>

      <div class="product-details">
        {% if product.vendor != blank %}<a class="product-brand" href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor }}</a>{% endif %}
        <h1>{{ product.title }}</h1>

        <div class="product-price-row">
          <span class="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="product-was"><s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></span>
            <span class="product-sale-badge">Sale</span>
          {% endif %}
        </div>

        <div class="product-shipping-callout">Shipping calculated at checkout.</div>

        {% form 'product', product, class: 'product-buy-form', data-product-form: true %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-product-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="product-options">
              {% for option in product.options_with_values %}
                <div class="product-option">
                  <label for="ProductOption-{{ section.id }}-{{ option.position }}">{{ option.name }} <span>[Select]</span></label>
                  <select
                    id="ProductOption-{{ section.id }}-{{ option.position }}"
                    name="options[{{ option.name | escape }}]"
                    data-product-option="{{ option.position }}"
                  >
                    <option value="" disabled>Select</option>
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="product-purchase-box">
            <div class="product-purchase-row">
              <label for="ProductQuantity-{{ section.id }}">Quantity</label>
              <input id="ProductQuantity-{{ section.id }}" class="product-quantity" type="number" name="quantity" min="1" value="1" aria-label="Quantity">
            </div>
            <button class="button product-add" type="submit" data-product-add {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
            {% if product.available %}
              <div class="product-buy-now">
                {{ form | payment_button }}
              </div>
            {% endif %}
          </div>
        {% endform %}

        <div class="product-lede" data-product-lede></div>
      </div>
    </div>

    <div class="product-information" id="product-content">
      <div class="product-information__content" data-product-description>
        {% if product.description != blank %}{{ product.description }}{% else %}<p>Authentic badminton equipment selected by OBA for players who train, play and compete.</p>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.product-page{padding-top:28px}
.product-layout--amazon{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:54px;align-items:start}
.product-gallery{display:grid;grid-template-columns:68px minmax(0,1fr);gap:14px;align-items:start;min-width:0}
.product-thumbs{display:flex;flex-direction:column;gap:8px;position:sticky;top:96px;max-height:calc(100vh - 112px);overflow:auto;border-radius:0}
.product-thumb{display:block;background:#e7e6eb;border:1px solid var(--oba-line);aspect-ratio:1;overflow:hidden;flex:0 0 auto;border-radius:0}
.product-thumb:hover,.product-thumb.is-active{border-color:var(--oba-ink)}
.product-thumb img{display:block;width:100%;height:100%;object-fit:contain}
.product-main-images{position:relative;min-width:0}
.product-image-track{position:relative;width:100%;aspect-ratio:1/1;background:#e7e6eb;border:1px solid rgba(16,16,16,.06);border-radius:14px;overflow:hidden}
.product-image{display:none;background:#e7e6eb;margin:0;width:100%;height:100%;padding:18px}
.product-image.is-active{display:block}
.product-image__zoom{position:relative;width:100%;height:100%;padding:0;border:0;display:block;overflow:hidden;cursor:zoom-in;background:#e7e6eb}
.product-image__zoom img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}
.product-image__zoom-hint{position:absolute;right:12px;bottom:12px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.9);color:var(--oba-ink);font-size:22px;line-height:1;box-shadow:0 2px 10px rgba(0,0,0,.12);pointer-events:none;opacity:.9}
.product-image__zoom:hover .product-image__zoom-hint{opacity:0}
.product-gallery-arrow{position:absolute;z-index:3;top:50%;transform:translateY(-50%);width:42px;height:42px;border:1px solid rgba(16,16,16,.12);border-radius:50%;background:rgba(255,255,255,.92);color:var(--oba-ink);font-size:28px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 3px 12px rgba(0,0,0,.12)}
.product-gallery-arrow:hover{background:var(--oba-accent);border-color:var(--oba-accent)}
.product-gallery-arrow--prev{left:12px}.product-gallery-arrow--next{right:12px}
.product-gallery-count{position:absolute;right:14px;bottom:14px;z-index:3;padding:6px 10px;border-radius:999px;background:rgba(16,16,16,.72);color:#fff;font-size:10px;letter-spacing:.08em}
.product-details{position:sticky;top:96px;height:max-content}
.product-brand{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;text-decoration:underline;text-underline-offset:3px}
.product-details h1{font-size:clamp(32px,3.2vw,48px);line-height:1.02;letter-spacing:-.045em;margin:8px 0 18px}
.product-price-row{display:flex;align-items:center;gap:12px;padding:0 0 14px;border-bottom:1px solid var(--oba-line)}
.product-price{font-size:28px;font-weight:800}.product-was{font-size:14px;color:var(--oba-muted)}
.product-sale-badge{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;padding:5px 9px;border-radius:999px;background:var(--oba-accent);color:var(--oba-ink)}
.product-shipping-callout{padding:12px 0 18px;font-size:12px;color:var(--oba-muted)}
.product-options{display:grid;gap:16px;margin:0 0 16px}
.product-option{display:grid;gap:7px}.product-option label{font-size:12px;font-weight:800;margin:0}.product-option label span{color:var(--oba-muted);font-weight:600}
.product-option select,.product-quantity{width:100%;height:46px;background:#fff;border:1px solid #b8b8b2;border-radius:8px;padding:0 12px;color:#101010;font-size:14px}
.product-purchase-box{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin:0;padding:18px;border:1px solid #c9c9c4;border-radius:14px;background:#f0f0ec;box-shadow:0 8px 24px rgba(16,16,16,.07)}
.product-purchase-row{grid-column:1 / -1;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:0}.product-purchase-row label{margin:0;font-size:12px;font-weight:800}.product-purchase-box > .product-add + .product-buy-now{display:flex;align-items:stretch}
.product-quantity{width:92px}.product-purchase-box > .product-add,.product-purchase-box > .product-buy-now{width:100%;flex:1 1 0;min-width:0}.product-purchase-box > .product-add{min-height:50px;margin:0;border-radius:9px;background:#101010;color:#fff;border-color:#101010;-webkit-text-fill-color:#fff;font-weight:900}.product-purchase-box > .product-buy-now{display:flex;align-items:stretch}.product-purchase-box > .product-buy-now .shopify-payment-button,.product-purchase-box > .product-buy-now .shop-pay-wallet-button{width:100%;height:100%;margin:0}.product-purchase-box > .product-buy-now .shopify-payment-button__button{width:100%;min-height:50px;height:100%;margin:0!important}
.product-add:hover{background:var(--oba-accent);color:#101010;border-color:var(--oba-accent);-webkit-text-fill-color:#101010}
.product-add:disabled{opacity:.5;cursor:not-allowed;background:#b9b9b4;border-color:#b9b9b4;color:#fff;-webkit-text-fill-color:#fff;transform:none;box-shadow:none}
.product-lede{color:var(--oba-muted);line-height:1.55;font-size:15px;font-weight:600;margin:20px 0 0}.product-lede>*{margin:0!important}
.product-information{margin-top:72px;padding:55px 0 20px;border-top:1px solid var(--oba-line)}
.product-information__content{max-width:980px;margin:0 auto;font-size:15px;line-height:1.8}.product-information__content>*:first-child{margin-top:0}
.product-information__content h1,.product-information__content h2,.product-information__content h3,.product-information__content h4{color:var(--oba-ink);letter-spacing:-.03em}
.product-information__content h1,.product-information__content h2{font-size:clamp(30px,4vw,48px);line-height:1;margin:42px 0 18px}.product-information__content h3{font-size:clamp(22px,3vw,34px);line-height:1.05;margin:42px 0 12px}.product-information__content h4{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin:28px 0 8px}
.product-information__content p{margin:0 0 18px}.product-information__content img{display:block;width:100%;max-width:760px;height:auto;margin:28px auto;border-radius:12px;background:#e7e6eb}
.product-information__content table{width:100%;border-collapse:collapse;margin:18px 0 42px;background:#fff}.product-information__content td,.product-information__content th{padding:13px 16px;border-bottom:1px solid var(--oba-line);text-align:left;vertical-align:top}.product-information__content td:first-child,.product-information__content th:first-child{width:28%;font-weight:800;color:var(--oba-ink)}
.product-information__content ul,.product-information__content ol{padding-left:22px;margin:0 0 24px}
@media(max-width:1100px){.product-layout--amazon{grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:30px}.product-gallery{grid-template-columns:60px minmax(0,1fr)}}
@media(max-width:900px){.product-layout--amazon{grid-template-columns:1fr}.product-details{position:static}.product-thumbs{position:static;max-height:none;overflow:visible}.product-information__content{max-width:760px}}
@media(max-width:600px){.product-purchase-box{grid-template-columns:1fr}.product-purchase-box > .product-add + .product-buy-now{margin-top:0}.product-page{padding-top:18px}.product-gallery{display:flex;flex-direction:column;gap:10px}.product-thumbs{display:grid;grid-template-columns:repeat(5,1fr);width:100%;order:2}.product-main-images{width:100%;order:1}.product-image-track{aspect-ratio:1/1}.product-image{padding:12px}.product-gallery-arrow{width:38px;height:38px}.product-gallery-count{right:10px;bottom:10px}.product-details h1{font-size:38px}.product-purchase-box{padding:16px;border-radius:12px}.product-information{margin-top:55px;padding-top:38px}.product-information__content{font-size:14px}}
</style>

<div class="product-image-modal" data-image-modal hidden aria-hidden="true">
  <div class="product-image-modal__backdrop" data-image-modal-close></div>
  <div class="product-image-modal__panel" role="dialog" aria-modal="true" aria-label="Enlarged product image">
    <button type="button" class="product-image-modal__close" data-image-modal-close aria-label="Close enlarged image">×</button>
    <div class="product-image-modal__viewport" data-image-modal-viewport><img class="product-image-modal__image" data-image-modal-image src="" alt=""></div>
    <div class="product-image-modal__zoom-controls" aria-label="Image magnification"><button type="button" class="product-image-modal__zoom-button" data-zoom-step="-1" aria-label="Zoom out" title="Zoom out"><span aria-hidden="true">−</span></button><span class="product-image-modal__zoom-level" data-zoom-level-label aria-live="polite">100%</span><button type="button" class="product-image-modal__zoom-button" data-zoom-step="1" aria-label="Zoom in" title="Zoom in"><span aria-hidden="true">+</span></button></div>
  </div>
</div>

<style>
.product-image-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:28px}.product-image-modal[hidden]{display:none}.product-image-modal__backdrop{position:absolute;inset:0;background:rgba(16,16,16,.72);backdrop-filter:blur(5px);cursor:zoom-out}.product-image-modal__panel{position:relative;z-index:1;width:min(92vw,1100px);height:min(88vh,850px);background:#e7e6eb;border-radius:14px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.35)}.product-image-modal__viewport{position:absolute;inset:0;overflow:auto;cursor:grab}.product-image-modal__image{display:block;width:100%;height:100%;min-width:100%;min-height:100%;max-width:none;object-fit:contain;padding:28px;transform-origin:center center;transition:transform .2s ease}.product-image-modal__zoom-controls{position:absolute;left:14px;bottom:14px;z-index:3;display:flex;gap:6px;padding:6px;border-radius:999px;background:rgba(255,255,255,.94);box-shadow:0 3px 14px rgba(0,0,0,.14)}.product-image-modal__zoom-button{width:40px;height:36px;border:1px solid #101010;border-radius:999px;background:#101010;color:#fff;font-size:17px;font-weight:900;line-height:1;display:grid;place-items:center;cursor:pointer;-webkit-text-fill-color:#fff}.product-image-modal__zoom-button:hover:not(:disabled){background:var(--oba-accent);border-color:var(--oba-accent);color:#101010;-webkit-text-fill-color:#101010}.product-image-modal__zoom-button:disabled{opacity:.35;cursor:not-allowed}.product-image-modal__zoom-level{min-width:52px;height:36px;display:grid;place-items:center;color:#101010;background:#fff;border-radius:999px;font-size:12px;font-weight:900}.product-image-modal__close{position:absolute;right:14px;top:14px;z-index:2;width:42px;height:42px;border:1px solid rgba(16,16,16,.14);border-radius:50%;background:rgba(255,255,255,.94);color:var(--oba-ink);font-size:30px;line-height:1;cursor:pointer}.product-image-modal__close:hover{background:var(--oba-accent)}
@media(max-width:600px){.product-image-modal{padding:12px}.product-image-modal__panel{width:96vw;height:82vh;border-radius:10px}.product-image-modal__image{padding:16px}}
</style>

<script type="application/json" data-product-variants>{{ product.variants | json }}</script>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}

<script>
(function(){
  function initProductVariants(){
    var form=document.querySelector('[data-product-form]');
    if(!form || form.dataset.variantsReady) return;
    form.dataset.variantsReady='true';
    var variantInput=form.querySelector('[data-product-variant-id]'),addButton=form.querySelector('[data-product-add]'),optionSelects=[...form.querySelectorAll('[data-product-option]')],variantsEl=document.querySelector('[data-product-variants]');
    if(!variantInput || !addButton || !variantsEl) return;
    var variants=[];try{variants=JSON.parse(variantsEl.textContent||'[]')}catch(e){return}
    function sync(){
      var selected=optionSelects.map(function(s){return s.value}),variant=variants.find(function(v){return !optionSelects.length||v.options.every(function(value,i){return value===selected[i]})});
      if(!variant)return;variantInput.value=variant.id;addButton.disabled=!variant.available;addButton.textContent=variant.available?'Add to cart':'Sold out';
    }
    optionSelects.forEach(function(s){s.addEventListener('change',sync)});sync();
  }
  function initProductModal(){
    var modal=document.querySelector('[data-image-modal]');if(!modal||modal.dataset.ready)return;modal.dataset.ready='true';
    var image=modal.querySelector('[data-image-modal-image]'),viewport=modal.querySelector('[data-image-modal-viewport]'),zoomButtons=modal.querySelectorAll('[data-zoom-step]'),label=modal.querySelector('[data-zoom-level-label]'),index=0,levels=[1,2,3];
    function zoom(i){index=Math.max(0,Math.min(levels.length-1,i));image.style.transform='scale('+levels[index]+')';label.textContent=(levels[index]*100)+'%';zoomButtons.forEach(function(b){var s=Number(b.dataset.zoomStep);b.disabled=(s<0&&index===0)||(s>0&&index===levels.length-1)})}
    function close(){modal.hidden=true;modal.setAttribute('aria-hidden','true');document.body.style.overflow=''}
    document.querySelectorAll('[data-image-zoom]').forEach(function(t){t.addEventListener('click',function(){var img=t.querySelector('img');if(!img)return;image.src=img.currentSrc||img.src;image.alt=img.alt||'';zoom(0);viewport.scrollLeft=0;viewport.scrollTop=0;modal.hidden=false;modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'})});
    modal.querySelectorAll('[data-image-modal-close]').forEach(function(b){b.addEventListener('click',close)});zoomButtons.forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();zoom(index+Number(b.dataset.zoomStep))})});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)close()});
  }
  function initProductGallery(root){if(!root||root.dataset.galleryReady)return;root.dataset.galleryReady='true';var slides=[...root.querySelectorAll('[data-gallery-slide]')],thumbs=[...document.querySelectorAll('.product-thumb')],current=root.querySelector('[data-gallery-current]'),prev=root.querySelector('[data-gallery-prev]'),next=root.querySelector('[data-gallery-next]'),index=0;if(slides.length<2){if(prev)prev.hidden=true;if(next)next.hidden=true;return}function show(i){index=(i+slides.length)%slides.length;slides.forEach(function(s,n){s.classList.toggle('is-active',n===index)});thumbs.forEach(function(t,n){t.classList.toggle('is-active',n===index)});if(current)current.textContent=index+1}prev&&prev.addEventListener('click',function(){show(index-1)});next&&next.addEventListener('click',function(){show(index+1)});thumbs.forEach(function(t,n){t.addEventListener('click',function(e){e.preventDefault();show(n)})});show(0)}
  initProductVariants();initProductModal();document.querySelectorAll('[data-product-gallery]').forEach(initProductGallery);
})();
</script>