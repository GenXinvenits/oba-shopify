<section class="section">
  <div class="container product-layout">
    <div class="product-gallery">
      {% for image in product.images %}<div class="product-image">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image.alt | default: product.title | escape }}</div>{% endfor %}
    </div>
    <div class="product-details">
      {% if product.vendor != blank %}<div class="eyebrow">{{ product.vendor }}</div>{% endif %}
      <h1>{{ product.title }}</h1>
      <div class="product-price">{{ product.selected_or_first_available_variant.price | money }}</div>
      {% if product.description != blank %}<div class="product-description">{{ product.description }}</div>{% endif %}
      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <label for="ProductSelect-{{ section.id }}">Options</label>
          <select id="ProductSelect-{{ section.id }}" name="id">
            {% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}
          </select>
        {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
        <button class="button product-add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
      {% endform %}
      <div class="product-note">Authentic badminton gear from the OBA Pro Shop. Free US shipping over $125.</div>
    </div>
  </div>
</section>

<style>.product-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.65fr);gap:70px}.product-gallery{display:grid;grid-template-columns:1fr 1fr;gap:14px}.product-image{background:#fff;aspect-ratio:1/1}.product-image img{width:100%;height:100%;object-fit:contain}.product-details{position:sticky;top:110px;height:max-content}.product-details h1{font-size:clamp(38px,5vw,70px);line-height:.92;letter-spacing:-.055em;margin:12px 0 20px}.product-price{font-size:22px;font-weight:800;margin-bottom:28px}.product-description{line-height:1.7;color:var(--oba-muted);margin-bottom:30px}.product-details select{display:block;width:100%;height:50px;background:#fff;border:1px solid var(--oba-line);padding:0 14px;margin:10px 0 16px}.product-add{width:100%;cursor:pointer}.product-note{margin-top:20px;font-size:12px;line-height:1.6;color:var(--oba-muted)}@media(max-width:900px){.product-layout{grid-template-columns:1fr;gap:35px}.product-details{position:static}}@media(max-width:600px){.product-gallery{grid-template-columns:1fr}}
</style>

{% schema %}{"name":"Main product","settings":[]}{% endschema %}
