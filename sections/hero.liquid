<section class="oba-hero-slider" data-oba-hero>
  <div class="oba-hero-slider__track">
    <article class="oba-hero-slide is-active">
      <div class="oba-hero-slide__media">
        <img src="https://us.yonex.com/cdn/shop/files/nanoflare_1000game.webp?v=1759793201&width=1445" alt="YONEX NANOFLARE 1000 GAME badminton racquet" loading="eager" fetchpriority="high">
      </div>
      <div class="oba-hero-slide__shade"></div>
      <div class="oba-hero-slide__content container">
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h1>NANOFLARE 1000 GAME.</h1>
        <p>Lightning-fast handling and explosive repulsion for players who want to accelerate every rally.</p>
        <div class="hero-actions">
          <a class="button" href="{{ routes.collections_url }}/rackets">Shop rackets</a>
          <a class="button button--light" href="{{ routes.collections_url }}">Shop all</a>
        </div>
      </div>
    </article>

    <article class="oba-hero-slide">
      <div class="oba-hero-slide__media">
        <img src="https://us.yonex.com/cdn/shop/files/NF700G_Midnight_Purple_1.png?v=1759792825&width=1445" alt="YONEX NANOFLARE 700 GAME badminton racquet" loading="lazy">
      </div>
      <div class="oba-hero-slide__shade"></div>
      <div class="oba-hero-slide__content container">
        <div class="eyebrow">YONEX NANOFLARE</div>
        <h2>PLAY FASTER.<br>MOVE FREER.</h2>
        <p>The NANOFLARE 700 GAME combines a head-light profile with responsive repulsion and easy maneuverability.</p>
        <div class="hero-actions">
          <a class="button" href="{{ routes.collections_url }}/rackets">Explore rackets</a>
          <a class="button button--light" href="{{ routes.collections_url }}">View collection</a>
        </div>
      </div>
    </article>

    <article class="oba-hero-slide">
      <div class="oba-hero-slide__media">
        <img src="https://us.yonex.com/cdn/shop/files/ALL_SHBELZ3M_532-1.png?v=1740774141&width=1445" alt="YONEX POWER CUSHION ECLIPSION Z badminton shoe" loading="lazy">
      </div>
      <div class="oba-hero-slide__shade"></div>
      <div class="oba-hero-slide__content container">
        <div class="eyebrow">YONEX POWER CUSHION</div>
        <h2>STABILITY.<br>CONTROL.<br>CONFIDENCE.</h2>
        <p>Built for quick turnarounds and agile footwork, with POWER CUSHION+ support under every step.</p>
        <div class="hero-actions">
          <a class="button" href="{{ routes.collections_url }}/shoes">Shop shoes</a>
          <a class="button button--light" href="{{ routes.collections_url }}">Shop all</a>
        </div>
      </div>
    </article>
  </div>

  <div class="oba-hero-slider__controls container">
    <div class="oba-hero-slider__counter"><strong data-hero-current>01</strong><span>/ 03</span></div>
    <div class="oba-hero-slider__dots" role="tablist" aria-label="Hero slides">
      <button type="button" class="is-active" data-hero-slide="0" aria-label="Show slide 1"></button>
      <button type="button" data-hero-slide="1" aria-label="Show slide 2"></button>
      <button type="button" data-hero-slide="2" aria-label="Show slide 3"></button>
    </div>
    <button type="button" class="oba-hero-slider__next" data-hero-next aria-label="Next slide">NEXT <span>↗</span></button>
  </div>
</section>

<style>
.oba-hero-slider{position:relative;min-height:calc(100svh - var(--header-height,0px));height:max(720px,calc(100svh - var(--header-height,0px)));background:radial-gradient(circle at 78% 42%,#eeece5 0%,#e2e0d9 30%,#d5d4cf 62%,#c9c9c4 100%);color:#111;overflow:hidden}
.oba-hero-slider__track,.oba-hero-slide,.oba-hero-slide__media{position:absolute;inset:0}
.oba-hero-slide{opacity:0;visibility:hidden;transition:opacity .8s ease,visibility .8s ease}
.oba-hero-slide.is-active{opacity:1;visibility:visible}
.oba-hero-slide__media{background:radial-gradient(circle at 78% 42%,#eeece5 0%,#e2e0d9 30%,#d5d4cf 62%,#c9c9c4 100%)}
.oba-hero-slide__media img{display:block;position:absolute;right:2%;top:50%;width:min(62vw,980px);height:90%;object-fit:contain;object-position:center center;transform:translateY(-50%) scale(1.04);transition:transform 7s cubic-bezier(.15,.75,.2,1)}
.oba-hero-slide.is-active .oba-hero-slide__media img{transform:translateY(-50%) scale(1)}
.oba-hero-slide:nth-child(2) .oba-hero-slide__media img{width:min(58vw,860px);height:86%}
.oba-hero-slide:nth-child(3) .oba-hero-slide__media img{width:min(58vw,820px);height:82%}
.oba-hero-slide__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(201,201,196,.96) 0%,rgba(216,215,210,.86) 30%,rgba(226,224,217,.58) 48%,rgba(238,236,229,0) 72%),linear-gradient(0deg,rgba(0,0,0,.04),transparent 45%)}
.oba-hero-slide__content{position:relative;z-index:2;min-height:inherit;height:100%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:40px;padding-bottom:110px}
.oba-hero-slide__content>*{opacity:0;transform:translateY(24px)}
.oba-hero-slide.is-active .oba-hero-slide__content>*{animation:obaHeroText .7s cubic-bezier(.2,.8,.2,1) forwards}
.oba-hero-slide.is-active .oba-hero-slide__content .eyebrow{animation-delay:.08s}
.oba-hero-slide.is-active .oba-hero-slide__content h1,.oba-hero-slide.is-active .oba-hero-slide__content h2{animation-delay:.16s}
.oba-hero-slide.is-active .oba-hero-slide__content p{animation-delay:.24s}
.oba-hero-slide.is-active .oba-hero-slide__content .hero-actions{animation-delay:.32s}
.oba-hero-slide .eyebrow{color:#555}
.oba-hero-slide h1,.oba-hero-slide h2{font-size:clamp(58px,8vw,126px);line-height:.79;letter-spacing:-.075em;margin:14px 0 28px;max-width:720px}
.oba-hero-slide p{max-width:480px;color:#444;font-size:17px;line-height:1.55;margin:0 0 28px}
.oba-hero-slide .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
.oba-hero-slide .button{background:#111;color:#fff;border-color:#111}
.oba-hero-slide .button:hover{background:var(--oba-accent);color:#111;border-color:var(--oba-accent)}
.oba-hero-slide .button--light{background:transparent;color:#111;border-color:#111}
.oba-hero-slide .button--light:hover{background:#111;color:#fff;border-color:#111}
.oba-hero-slider__controls{position:absolute;z-index:5;bottom:28px;left:50%;transform:translateX(-50%);display:grid;grid-template-columns:100px 1fr 100px;align-items:center;gap:20px}
.oba-hero-slider__counter{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#777}
.oba-hero-slider__counter strong{color:#111;font-size:15px;margin-right:5px}
.oba-hero-slider__dots{display:flex;justify-content:center;gap:8px}
.oba-hero-slider__dots button{width:42px;height:2px;padding:0;border:0;background:rgba(17,17,17,.25);cursor:pointer;transition:background .3s,width .3s}
.oba-hero-slider__dots button.is-active{background:#111;width:64px}
.oba-hero-slider__next{justify-self:end;border:0;background:transparent;color:#111;font-size:10px;letter-spacing:.14em;font-weight:800;cursor:pointer;padding:10px 0}
.oba-hero-slider__next span{font-size:16px;margin-left:6px;transition:transform .2s;display:inline-block}
.oba-hero-slider__next:hover span{transform:translate(3px,-3px)}
@keyframes obaHeroText{to{opacity:1;transform:none}}
@media(max-width:900px){
  .oba-hero-slide__media img{right:-8%;width:68vw;height:72%;opacity:.95}
  .oba-hero-slide:nth-child(2) .oba-hero-slide__media img,.oba-hero-slide:nth-child(3) .oba-hero-slide__media img{width:65vw;height:68%}
  .oba-hero-slide__shade{background:linear-gradient(90deg,rgba(201,201,196,.96) 0%,rgba(216,215,210,.88) 38%,rgba(226,224,217,.36) 72%,rgba(238,236,229,0) 100%),linear-gradient(0deg,rgba(216,215,210,.25),transparent 55%)}
}
@media(max-width:700px){
  .oba-hero-slider{min-height:78svh;height:78svh;max-height:none}
  .oba-hero-slide__media img{right:-16%;top:34%;width:92vw;height:55%;opacity:.82}
  .oba-hero-slide:nth-child(2) .oba-hero-slide__media img,.oba-hero-slide:nth-child(3) .oba-hero-slide__media img{width:88vw;height:52%}
  .oba-hero-slide__shade{background:linear-gradient(180deg,rgba(238,236,229,.18) 0%,rgba(226,224,217,.52) 38%,#d5d4cf 68%,#d5d4cf 100%)}
  .oba-hero-slide__content{justify-content:flex-end;padding-bottom:105px}
  .oba-hero-slide h1,.oba-hero-slide h2{font-size:clamp(50px,14vw,76px);max-width:92vw}
  .oba-hero-slide p{font-size:15px;max-width:360px}
  .oba-hero-slider__controls{grid-template-columns:60px 1fr 65px;bottom:18px;gap:10px}
  .oba-hero-slider__dots button{width:24px}
  .oba-hero-slider__dots button.is-active{width:38px}
}
@media(prefers-reduced-motion:reduce){
  .oba-hero-slide,.oba-hero-slide__media img{transition:none}
  .oba-hero-slide.is-active .oba-hero-slide__content>*{animation:none;opacity:1;transform:none}
}
</style>

<script>
(() => {
  const initHeroSlider = () => {
    document.querySelectorAll('[data-oba-hero]').forEach((hero) => {
      if (hero.dataset.heroReady === 'true') return;
      const slides = [...hero.querySelectorAll('.oba-hero-slide')];
      const dots = [...hero.querySelectorAll('[data-hero-slide]')];
      const current = hero.querySelector('[data-hero-current]');
      const next = hero.querySelector('[data-hero-next]');
      if (slides.length < 2) return;
      hero.dataset.heroReady = 'true';
      let index = slides.findIndex((slide) => slide.classList.contains('is-active'));
      if (index < 0) index = 0;
      let timer = null;
      const show = (nextIndex) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        if (current) current.textContent = String(index + 1).padStart(2, '0');
      };
      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => show(index + 1), 6500);
      };
      dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
      next?.addEventListener('click', () => { show(index + 1); start(); });
      hero.addEventListener('mouseenter', () => window.clearInterval(timer));
      hero.addEventListener('mouseleave', start);
      hero.addEventListener('focusin', () => window.clearInterval(timer));
      hero.addEventListener('focusout', start);
      show(index);
      start();
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHeroSlider, { once: true });
  else initHeroSlider();
})();
</script>

{% schema %}
{
  "name":"OBA Hero Slider",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OBA PRO SHOP"},
    {"type":"text","id":"heading","label":"Heading","default":"PLAY WITH PURPOSE."},
    {"type":"textarea","id":"text","label":"Text","default":"Authentic badminton gear selected for players who train, compete and love the game."},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop rackets"},
    {"type":"url","id":"primary_link","label":"Primary link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Shop all"},
    {"type":"url","id":"secondary_link","label":"Secondary link"}
  ],
  "presets":[{"name":"OBA Hero Slider"}]
}
{% endschema %}
