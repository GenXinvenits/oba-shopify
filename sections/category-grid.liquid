<section class="section category-section">
  <div class="container">
    <div class="category-section__heading">
      <div class="category-section__meta">
        <span class="category-section__index" aria-hidden="true">01</span>
        <span class="eyebrow">Explore the collection</span>
      </div>
      <div class="category-section__title">
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="category-section__intro">
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        <a class="category-section__all" href="{{ routes.collections_url }}">
          <span>View all</span>
          <span class="category-section__all-icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        <a class="category-card" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          {% elsif collection.featured_image != blank %}
            {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          {% endif %}
          <div class="category-card__content">
            <div class="eyebrow">Shop category</div>
            <h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif collection != blank %}{{ collection.title }}{% else %}Category{% endif %}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{"name":"Shop by category","settings":[{"type":"text","id":"heading","label":"Heading","default":"SHOP BY CATEGORY"},{"type":"textarea","id":"text","label":"Intro","default":"Build your setup from rackets, shoes, shuttles and the gear you trust on court."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"title","label":"Title override"}]}],"max_blocks":6,"presets":[{"name":"Shop by category","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}
{% endschema %}
