<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><div class="eyebrow">Equip</div><h2>{{ section.settings.heading }}</h2></div>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        <a class="category-card" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          {% assign banner_url = blank %}
          {% if block.settings.image != blank %}
            {% assign banner_url = block.settings.image | image_url: width: 1400 %}
          {% elsif collection.handle == 'rackets' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/heroimage_b_racquets_260206_1.jpg' %}
          {% elsif collection.handle == 'shoes' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/heroimage_b_footwear_260206_1.jpg' %}
          {% elsif collection.handle == 'bag' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/heroimage_b_bag_260206.jpg' %}
          {% elsif collection.handle == 'accessories' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/2880x1400_AC_pc_2024_1.jpg' %}
          {% elsif collection.handle == 'apparel' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/bad_260123_banner_1.jpg' %}
          {% elsif collection.handle == 'shuttlecocks' %}
            {% assign banner_url = 'https://www.yonex.com/media/catalog/category/heroimage_shuttle_260206_1.jpg' %}
          {% elsif collection.featured_image != blank %}
            {% assign banner_url = collection.featured_image | image_url: width: 1400 %}
          {% endif %}
          {% if banner_url != blank %}
            <img src="{{ banner_url }}" alt="{{ block.settings.title | default: collection.title | escape }}" loading="lazy" width="1400" height="700">
          {% endif %}
          <div class="category-card__content">
            <div class="eyebrow">Shop</div>
            <h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif collection != blank %}{{ collection.title }}{% else %}Category{% endif %}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{"name":"Shop by category","settings":[{"type":"text","id":"heading","label":"Heading","default":"SHOP BY CATEGORY"},{"type":"textarea","id":"text","label":"Intro","default":"Build your setup from rackets, shoes, shuttles and the gear you trust on court."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"title","label":"Title override"}]}],"max_blocks":6,"presets":[{"name":"Shop by category","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}
{% endschema %}
