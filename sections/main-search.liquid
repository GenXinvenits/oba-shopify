<section class="section search-page">
  <div class="container">
    <div class="section-heading">
      <div>
        <div class="eyebrow">OBA PRO SHOP</div>
        <h1>{{ 'Search' }}</h1>
      </div>
      {% if search.performed %}
        <p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
      {% endif %}
    </div>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">Search products</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search rackets, shoes, shuttles…" autocomplete="off">
      <input type="hidden" name="type" value="product">
      <button class="button" type="submit">Search</button>
    </form>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="product-grid search-results">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item %}
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state">
          <h2>No products found.</h2>
          <p>Try a different search or browse the full OBA Pro Shop.</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">Shop all</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

<style>
.search-form{display:flex;max-width:760px;margin:0 0 56px;border-bottom:2px solid var(--oba-ink)}
.search-form input{flex:1;min-width:0;border:0;background:transparent;padding:16px 4px;font-size:18px;outline:0}
.search-form .button{border-radius:0;min-height:52px}
.search-results{margin-top:20px}
.empty-state{padding:70px 0;border-top:1px solid var(--oba-line)}
.empty-state h2{font-size:clamp(34px,5vw,60px);line-height:.95;letter-spacing:-.04em;margin:0 0 14px}
.empty-state p{color:var(--oba-muted);margin:0 0 24px}
.visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>

{% schema %}
{"name":"Search results","settings":[]}
{% endschema %}
