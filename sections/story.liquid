<section class="story">
  <div class="story-grid">
    <div class="story-map">
      <img src="https://oregonbadminton.com/cdn/shop/files/Map_1c36161a-6e63-4dd4-8852-33861f9a778f_1728x.png?v=1653187638" alt="Oregon Badminton Academy location map" loading="lazy" class="story-map__image" width="1728" height="664" draggable="true">
    </div>
    <div class="story-content">
      <div>
        <div class="eyebrow">More than a pro shop</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}<a class="button button--light" href="{{ section.settings.button_link }}"> {{ section.settings.button_label }} </a>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.story-map{overflow:hidden;background:#e7e6eb}
.story-map__image{display:block;width:100%;height:auto;max-width:100%;cursor:grab;user-select:none}
.story-map__image:active{cursor:grabbing}
@media(max-width:749px){.story-grid{grid-template-columns:1fr}}
</style>

{% schema %}
{"name":"OBA story","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Optional. Uses an OBA image automatically when left blank."},{"type":"text","id":"heading","label":"Heading","default":"TRAIN. PLAY. COMPETE."},{"type":"textarea","id":"text","label":"Text","default":"Oregon Badminton Academy is a community built around the sport. Our Pro Shop brings that same player-first mindset to the gear you use on court — authentic equipment from brands trusted by badminton players."},{"type":"text","id":"button_label","label":"Button","default":"Visit OBA"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"OBA story"}]}
{% endschema %}
