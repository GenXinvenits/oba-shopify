<section class="story">
  <div class="story-grid">
    <div class="story-map">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d453.50646403795685!2d-122.79249943303573!3d45.477656858203595!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54950c16e5d9191b%3A0x7451b3b9996c0d86!2sOregon%20Badminton%20Academy!5e0!3m2!1sen!2sin!4v1791027951526!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <div class="story-content">
      <div>
        <div class="eyebrow">More than a pro shop</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}<a class="button button--light" href="{{ section.settings.button_link }}"> {{ section.settings.button_label }} </a>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.story-map{min-height:clamp(520px,50vw,820px);overflow:hidden;background:#e7e6eb}
.story-map iframe{display:block;width:100%;height:100%;min-height:inherit;border:0}
@media(max-width:749px){.story-grid{grid-template-columns:1fr}.story-map{min-height:70vw;max-height:620px}.story-map iframe{min-height:inherit}}
</style>

{% schema %}
{"name":"OBA story","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Optional. Uses an OBA image automatically when left blank."},{"type":"text","id":"heading","label":"Heading","default":"TRAIN. PLAY. COMPETE."},{"type":"textarea","id":"text","label":"Text","default":"Oregon Badminton Academy is a community built around the sport. Our Pro Shop brings that same player-first mindset to the gear you use on court — authentic equipment from brands trusted by badminton players."},{"type":"text","id":"button_label","label":"Button","default":"Visit OBA"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"OBA story"}]}
{% endschema %}