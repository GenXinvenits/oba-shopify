<section class="story">
  <div class="story-grid">
    <div class="story-media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(min-width: 900px) 50vw, 100vw', class: 'story-media__image' }}
      {% else %}
        <img src="https://orbadminton.com/wp-content/uploads/2025/04/enhacningg-Picsart-AiImageEnhancer-700x800.png" alt="Oregon Badminton Academy players training" loading="lazy" class="story-media__image">
      {% endif %}
    </div>
    <div class="story-content">
      <div>
        <div class="eyebrow">More than a pro shop</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}<a class="button button--light" href="{{ section.settings.button_link }}"> {{ section.settings.button_label }} </a>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.story-media{overflow:hidden;min-height:clamp(520px,50vw,820px);background:#111}
.story-media__image{display:block;width:100%;height:100%;min-height:inherit;object-fit:cover;object-position:center}
@media(max-width:749px){.story-grid{grid-template-columns:1fr}.story-media{min-height:70vw;max-height:620px}}
</style>

{% schema %}
{"name":"OBA story","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Optional. Uses an OBA image automatically when left blank."},{"type":"text","id":"heading","label":"Heading","default":"TRAIN. PLAY. COMPETE."},{"type":"textarea","id":"text","label":"Text","default":"Oregon Badminton Academy is a community built around the sport. Our Pro Shop brings that same player-first mindset to the gear you use on court — authentic equipment from brands trusted by badminton players."},{"type":"text","id":"button_label","label":"Button","default":"Visit OBA"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"OBA story"}]}
{% endschema %}
