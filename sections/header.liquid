.nav-sale{color:var(--oba-m3-primary)!important;background:var(--oba-m3-primary-container)!important}.nav-sale:before{display:none!important} .header-search{position:relative;display:block}.header-search>summary{list-style:none}.header-search>summary::-webkit-details-marker{display:none}.header-search-dropdown{position:absolute;top:calc(100% + 10px);right:0;width:min(420px,calc(100vw - 32px));padding:12px;border:1px solid var(--oba-m3-outline);border-radius:20px;background:var(--oba-m3-surface);box-shadow:var(--oba-m3-shadow-3);z-index:110;animation:headerSearchDrop .2s cubic-bezier(.2,.8,.2,1) both}.header-search-form{display:flex;align-items:center;gap:10px;min-height:48px;padding:5px 6px 5px 14px;border:1px solid var(--oba-m3-outline);border-radius:999px;background:var(--oba-m3-surface-high);overflow:hidden}.header-search-form svg{width:19px;height:19px;flex:0 0 auto;fill:none;stroke:var(--oba-m3-primary);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.header-search-form input{min-width:0;width:100%;height:38px;padding:0;border:0;background:transparent;color:var(--oba-ink);font:inherit;font-size:13px;outline:0}.header-search-form input::placeholder{color:var(--oba-muted);opacity:1}.header-search-submit{height:36px;padding:0 14px;border:0;border-radius:999px;background:var(--oba-m3-primary);color:var(--oba-m3-on-primary);font:inherit;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;white-space:nowrap}.header-search-submit:hover{filter:brightness(.96);transform:translateY(-1px)}.header-search-toggle{border:0;background:transparent;cursor:pointer}.header-search-toggle:hover{background:var(--oba-m3-surface-high)}@keyframes headerSearchDrop{from{opacity:0;transform:translateY(-6px) scale(.98)}to{opacity:1;transform:none}}.header-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px;height:100%;font-size:10px;text-transform:uppercase;font-weight:800;letter-spacing:.08em}.header-action{position: