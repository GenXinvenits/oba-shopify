<script>
(() => {
  const shop = document.querySelector('.nav-shop');
  const summary = shop?.querySelector(':scope > summary');
  const menu = shop?.querySelector(':scope > .mega-menu');
  if (!shop || !summary || !menu) return;

  let closingTimer;

  summary.addEventListener('click', (event) => {
    event.preventDefault();
    clearTimeout(closingTimer);

    if (shop.open) {
      menu.classList.remove('mega-menu--visible');
      menu.classList.add('mega-menu--closing');

      closingTimer = window.setTimeout(() => {
        shop.open = false;
        menu.classList.remove('mega-menu--closing');
      }, 300);
      return;
    }

    shop.open = true;
    menu.classList.remove('mega-menu--closing');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => menu.classList.add('mega-menu--visible'));
    });
  });
})();
</script>
