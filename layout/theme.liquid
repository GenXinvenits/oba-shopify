<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>:root{--oba-accent:{{ settings.accent_color | default: '#d8ff3e' }};--oba-bg:{{ settings.background_color | default: '#f5f5f1' }};--oba-ink:{{ settings.ink_color | default: '#101010' }}}</style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'oba-material.css' | asset_url | stylesheet_tag }}
    {{ 'quick-view.css' | asset_url | stylesheet_tag }}
    <style>.site-header-sticky-shell{position:sticky;top:0;z-index:100;width:100%;}</style>
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    <div class="site-header-sticky-shell">{% section 'header' %}</div>
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}

    <div class="oba-cart-drawer" data-cart-drawer hidden>
      <button class="oba-cart-drawer__backdrop" type="button" data-cart-drawer-close aria-label="Close cart"></button>
      <aside class="oba-cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
        <div class="oba-cart-drawer__header">
          <div>
            <span class="eyebrow">Your gear</span>
            <h2 id="CartDrawerTitle">Cart <span data-cart-drawer-count>{{ cart.item_count }}</span></h2>
          </div>
          <button class="oba-cart-drawer__close" type="button" data-cart-drawer-close aria-label="Close cart">×</button>
        </div>
        <div class="oba-cart-drawer__body" data-cart-drawer-body>
          {% if cart.item_count == 0 %}
            <div class="oba-cart-drawer__empty"><p>Your cart is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop the Pro Shop</a></div>
          {% else %}
            {% for item in cart.items %}
              <article class="oba-cart-line">
                <a class="oba-cart-line__image" href="{{ item.url }}">{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title | escape }}</a>
                <div class="oba-cart-line__content">
                  <a class="oba-cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  <span class="oba-cart-line__price">{{ item.final_line_price | money }}</span>
                  <div class="oba-cart-line__controls">
                    <span>Qty {{ item.quantity }}</span>
                    <a href="{{ item.url_to_remove }}" data-cart-remove="{{ item.key }}">Remove</a>
                  </div>
                </div>
              </article>
            {% endfor %}
          {% endif %}
        </div>
        <div class="oba-cart-drawer__footer" data-cart-drawer-footer{% if cart.item_count == 0 %} hidden{% endif %}>
          <div class="oba-cart-drawer__subtotal"><span>Subtotal</span><strong data-cart-drawer-total>{{ cart.total_price | money }}</strong></div>
          <p>Taxes and shipping calculated at checkout.</p>
          <a class="button oba-cart-drawer__checkout" href="{{ routes.cart_url }}">View cart &amp; checkout</a>
        </div>
      </aside>
    </div>

    <div class="oba-quick-view" data-quick-view-modal hidden>
      <button class="oba-quick-view__backdrop" type="button" data-quick-view-close aria-label="Close quick view"></button>
      <div class="oba-quick-view__panel" role="dialog" aria-modal="true">
        <button class="oba-quick-view__close" type="button" data-quick-view-close aria-label="Close quick view">×</button>
        <div class="oba-quick-view__content" data-quick-view-content>
          <div class="oba-quick-view__loading" data-quick-view-loading>Loading product…</div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" defer></script>
    <script src="{{ 'homepage-scroll.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
